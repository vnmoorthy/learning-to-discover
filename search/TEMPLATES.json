 "autocorr1_polish": {
  "problem": "first-autocorrelation-inequality",
  "script": "search/autocorr1_polish.py",
  "resource": "gpu",
  "params": {
   "seed": {
    "type": "int",
    "min": 0,
    "max": 100000,
    "default": 0
   },
   "seconds": {
